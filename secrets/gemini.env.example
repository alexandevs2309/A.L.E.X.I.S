# ALEXIS — credenciales de modelos cloud (Gemini y compatibles)
#
# CÓMO USAR (nunca copies este archivo tal cual):
#   cp secrets/gemini.env.example secrets/gemini.env
#   $EDITOR secrets/gemini.env     # pega tu key real
#   set -a; . secrets/gemini.env; set +a
#
# `secrets/*.env` está en .gitignore Y en .dockerignore: no se versiona ni viaja en la
# imagen. Comparte sólo este `.example`.
# La key se crea en https://aistudio.google.com/apikey y se rota desde el mismo panel.

# Requerida por el provider openai_compatible (alexis/models/providers/openai_compatible.py).
ALEXIS_MODEL_API_KEY=

# Ejemplo con Gemini (API compatible con OpenAI):
#   ALEXIS_MODEL_PROVIDER=openai_compatible
#   ALEXIS_MODEL_BASE_URL=https://generativelanguage.googleapis.com
#   ALEXIS_MODEL_ENDPOINT=/v1beta/openai/chat/completions
#   ALEXIS_MODEL_NAME=gemini-3.5-flash
#
# Los modelos Gemini 3.x razonan antes de responder: suben ALEXIS_MODEL_MAX_TOKENS
# (por defecto 220) o la respuesta llega vacía y el router la marca UNAVAILABLE.
