# ALEXIS — credenciales de servicios externos
#
# Copia cada línea a un archivo real en `secrets/` (ignorado por git) y carga el
# archivo con tu gestor de secretos o con `set -a; . secrets/<servicio>.env; set +a`.
# Este archivo NUNCA contiene valores reales.

# --- Voz: ElevenLabs (opcional; hay TTS local sin credenciales) -------------
# Plantilla: secrets/elevenlabs.env.example
ALEXIS_ELEVENLABS_API_KEY=
ALEXIS_ELEVENLABS_VOICE_ID=

# --- Percepción de pantalla (futuro C4) ------------------------------------
# ALEXIS_VISION_ENABLED=0
