# ALEXIS — variables de entorno para docker compose
#
# R6: `docker compose up` NO arranca sin POSTGRES_PASSWORD y ALEXIS_API_TOKEN.
# Este archivo es la plantilla; el real es `.env` (ignorado por git).
#
#   cp .env.example .env && $EDITOR .env
#
# Ver docs/DEVELOPMENT.md §7.

# --- PostgreSQL (obligatorio) ----------------------------------------------
# Contraseña del usuario `alexis` de PostgreSQL. Sin default: si falta, compose falla.
# Genera una con: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# --- API (obligatorio) ------------------------------------------------------
# Token que exigen los endpoints de la API (cabecera `X-ALEXIS-Token`).
# En ALEXIS_ENV=production es además obligatorio en el arranque de la app.
# Genera uno con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ALEXIS_API_TOKEN=

# --- Entorno (opcional) -----------------------------------------------------
# development | production. En production la API exige el token al arrancar.
ALEXIS_ENV=development
